# ============================================================
# Trading Bot — credentials and mode flags
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Exchange selector ─────────────────────────────────────
# Which exchange adapter to use for live/paper trading
# Options: hyperliquid | binance  (default: binance)
EXCHANGE=binance

# ── Binance credentials ───────────────────────────────────
# Required for authenticated endpoints (order placement, account info).
# Historical / public market data needs NO credentials.
# Generate keys at: https://www.binance.com/en/my/settings/api-management
# For testnet:      https://testnet.binancefuture.com
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Set to "true" ONLY after thorough paper-trading validation.
# Live trading on Binance is DISABLED by default.
BINANCE_LIVE_TRADING_ENABLED=false

# Use testnet for authenticated sessions (safe default)
# testnet: https://testnet.binancefuture.com
# mainnet: https://fapi.binance.com
BINANCE_USE_TESTNET=true

# ── Hyperliquid credentials ───────────────────────────────
# Only needed if EXCHANGE=hyperliquid

# Wallet private key (hex string, no 0x prefix required)
HL_PRIVATE_KEY=your_private_key_here

# Wallet address (public Ethereum-style address)
HL_WALLET_ADDRESS=0xYourWalletAddressHere

# API base URL — mainnet
HL_API_URL=https://api.hyperliquid.xyz

# WebSocket URL — mainnet
HL_WS_URL=wss://api.hyperliquid.xyz/ws

# Set to "true" ONLY after thorough paper-trading validation.
LIVE_TRADING_ENABLED=false

# ── Shared settings ───────────────────────────────────────
# Paper trading starting balance (USD)
PAPER_BALANCE=10000.0

# Environment label (paper | live)
TRADING_MODE=paper
